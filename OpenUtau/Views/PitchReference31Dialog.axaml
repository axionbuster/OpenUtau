<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenUtau.App.Views.PitchReference31Dialog"
        Title="31-TET reference pitch" Icon="/Assets/open-utau.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="NumericUpDown">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="4,0"/>
    </Style>
  </Window.Styles>
  <Border Margin="{Binding $parent[Window].WindowDecorationMargin}">
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="Choose the absolute pitch anchor for this project. Note positions and interval sizes do not change."
                 TextWrapping="Wrap"/>

      <RadioButton Name="A4Mode" GroupName="ReferenceMode" Content="Fix A4 to an absolute frequency"
                   Click="OnModeChanged"/>
      <Grid ColumnDefinitions="*,150" Margin="28,0,0,0">
        <TextBlock Text="A4 frequency (Hz)" VerticalAlignment="Center"/>
        <NumericUpDown Name="A4Frequency" Grid.Column="1" Minimum="1" Maximum="20000"
                       Increment="0.1" FormatString="0.###" ValueChanged="OnFrequencyChanged"/>
      </Grid>

      <RadioButton Name="NoteMode" GroupName="ReferenceMode" Content="Synchronize with a 12-TET note"
                   Click="OnModeChanged"/>
      <Grid ColumnDefinitions="*,150" Margin="28,0,0,0">
        <TextBlock Text="12-TET pitch class (A4 = 440 Hz)" VerticalAlignment="Center"/>
        <ComboBox Name="ReferenceNote" Grid.Column="1" SelectionChanged="OnReferenceNoteChanged"/>
      </Grid>

      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="10" CornerRadius="4">
        <TextBlock Name="Summary" TextWrapping="Wrap"/>
      </Border>

      <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
        <Button Grid.Column="0" Content="{DynamicResource button.cancel}" Click="OnCancel"/>
        <Button Grid.Column="2" Content="{DynamicResource button.ok}" Click="OnOk"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
